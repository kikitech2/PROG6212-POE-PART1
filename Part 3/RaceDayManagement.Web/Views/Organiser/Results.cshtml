@model RaceDayManagement.Web.Models.ResultViewModel

@{
    ViewData["Title"] = "Results Entry";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white fw-bold">
                    Record Participant Result
                </div>
                <div class="card-body">
                    <form asp-action="Results" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="EventId" />

                        <div class="mb-3">
                            <label asp-for="EnrolmentId" class="form-label fw-bold">Enrolment ID</label>
                            <input asp-for="EnrolmentId" class="form-control" type="number" placeholder="Enter valid Enrolment ID (e.g. 1)" />
                            <span asp-validation-for="EnrolmentId" class="text-danger"></span>
                            <small class="text-muted">The ID of the participant's enrolment for this event.</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FinishTime" class="form-label fw-bold">Finish Time</label>
                            <input asp-for="FinishTime" class="form-control" placeholder="e.g. 03:45:12" />
                            <span asp-validation-for="FinishTime" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Position" class="form-label fw-bold">Position</label>
                            <input asp-for="Position" class="form-control" type="number" placeholder="1" />
                            <span asp-validation-for="Position" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Dashboard" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-success px-4 fw-bold">Save Result</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
