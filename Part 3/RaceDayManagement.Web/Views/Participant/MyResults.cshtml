@model IEnumerable<RaceDayManagement.Web.Models.ParticipantResultViewModel>

@{
    ViewData["Title"] = "My Race Results";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2>My Race Results & Finishes</h2>
            <p class="text-muted">Review your official finish times and event positions.</p>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model == null || !Model.Any())
            {
                <p class="text-muted">No results recorded for your profile yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Event Name</th>
                                <th>Finish Time</th>
                                <th class="text-center">Position</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var res in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@res.EventName</td>
                                    <td><code>@res.FinishTime</code></td>
                                    <td class="text-center">
                                        <span class="badge bg-success fs-6">#@res.Position</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
