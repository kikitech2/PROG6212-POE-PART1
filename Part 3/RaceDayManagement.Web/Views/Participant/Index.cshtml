@model IEnumerable<RaceDayManagement.Web.Models.EventViewModel>

@{
    ViewData["Title"] = "Available Events";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2>Explore Upcoming Race Events</h2>
            <p class="text-muted">Browse upcoming events, view details, and secure your spot!</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        @if (Model == null || !Model.Any())
        {
            <div class="col-12">
                <p class="text-muted">No upcoming events available at the moment.</p>
            </div>
        }
        else
        {
            @foreach (var ev in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(ev.ImageUrl))
                        {
                            <img src="@ev.ImageUrl" class="card-img-top" alt="Event Banner" style="height: 180px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 180px;">
                                <span>No Image Available</span>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold">@ev.Name</h5>
                            <p class="text-muted small mb-2">@ev.Date.ToString("yyyy-MM-dd HH:mm") | @ev.Location</p>
                            <p class="card-text">@(ev.Description.Length > 100 ? ev.Description.Substring(0, 100) + "..." : ev.Description)</p>
                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="badge bg-info text-dark">@ev.EventType (@ev.Distance)</span>
                                    <span class="fw-bold text-success">R @ev.EntryFee.ToString("N2")</span>
                                </div>
                                <a asp-action="Details" asp-route-id="@ev.EventId" class="btn btn-outline-primary w-100 fw-bold">View Details & Enrol</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
