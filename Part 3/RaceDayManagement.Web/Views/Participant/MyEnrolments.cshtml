@model IEnumerable<RaceDayManagement.Web.Models.EnrolmentViewModel>

@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2>My Event Enrolments</h2>
            <p class="text-dark fw-medium">Track all the races you have registered and enrolled for.</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Index" class="btn btn-primary fw-bold">+ Browse More Events</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model == null || !Model.Any())
            {
                <p class="text-muted">You have not enrolled in any events yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Event Name</th>
                                <th>Category</th>
                                <th>Enrolment Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var enrolment in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@enrolment.EventName</td>
                                    <td><span class="badge bg-info text-dark">@enrolment.Category</span></td>
                                    <td>@enrolment.EnrolmentDate.ToString("yyyy-MM-dd")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
